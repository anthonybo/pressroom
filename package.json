{
	"name": "pressroom",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "A live terminal dashboard of every commit landing in ~/projects",
	"bin": {
		"pressroom": "bin/pressroom"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"dev": "tsx src/index.ts",
		"check": "npm run check:types && npm test && npm run check:contrast",
		"check:types": "tsc --noEmit",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"frames": "tsx scripts/frames.tsx",
		"format": "prettier --write .",
		"probe": "node --expose-gc --import tsx scripts/probe.tsx",
		"check:contrast": "node --import tsx scripts/contrast.mjs",
		"colors": "FORCE_COLOR=3 COLORTERM=truecolor tsx scripts/colors.tsx",
		"demo": "node scripts/demo.mjs",
		"screenshot": "node scripts/demo.mjs --screenshot"
	},
	"dependencies": {
		"ink": "^7.1.1",
		"react": "^19.2.8",
		"string-width": "^8.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"prettier": "^3.4.2",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
